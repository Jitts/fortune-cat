# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook secret — from Stripe dashboard → Webhooks → your endpoint
# For local dev: stripe listen --forward-to localhost:3000/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Your price IDs from Stripe dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_

# ── Stripe Connect (set by Vibe Launchpad when provisioned via platform) ────
# Leave blank if running standalone with your own Stripe account
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_PLATFORM_FEE_PERCENT=

# ── Microsoft sign-in (optional, but it is the ONLY credential-free email path)
# Without these two the "Continue with Microsoft" button is hidden entirely and
# every Outlook/Hotmail user is pushed to an IMAP app password instead — which
# is the step beta testers refuse. The code is already written; this is the
# only thing switching it off.
#
# Entra ID (Azure) → App registrations → New registration:
#   Supported account types: "Accounts in any organizational directory and
#     personal Microsoft accounts" (the code uses the /common tenant)
#   Redirect URI (type Web): <your app url>/api/oauth/microsoft/callback
#   API permissions → Microsoft Graph → Delegated: Mail.Read, User.Read,
#     offline_access
#   Certificates & secrets → New client secret → copy the VALUE, not the ID
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
